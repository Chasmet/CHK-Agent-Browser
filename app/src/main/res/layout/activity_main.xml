<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0D1423">
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◉  CHK AGENT BROWSER" android:textColor="#EAF3FF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/agent" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="12dp" android:text="Lire page" android:textColor="#6ED2FF" />
        <TextView android:id="@+id/settings" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="24sp" android:textColor="#EAF3FF" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:paddingHorizontal="6dp">
        <TextView android:id="@+id/back" style="@style/NavButton" android:text="‹" />
        <TextView android:id="@+id/forward" style="@style/NavButton" android:text="›" />
        <EditText android:id="@+id/address" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/field_bg" android:singleLine="true" android:inputType="textUri" android:imeOptions="actionGo" android:selectAllOnFocus="true" android:hint="Adresse ou recherche" android:textColor="#FFFFFF" android:textColorHint="#A4B5CA" android:paddingHorizontal="12dp" android:textSize="14sp" />
        <TextView android:id="@+id/go" style="@style/NavButton" android:text="➜" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="43dp" android:scrollbars="none"><LinearLayout android:id="@+id/tab_strip" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" /></HorizontalScrollView>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:progressTint="#6ED2FF" android:visibility="gone" />
    <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="53dp" android:gravity="center_vertical" android:background="#111E30" android:paddingHorizontal="6dp">
        <TextView android:id="@+id/new_tab" style="@style/BottomButton" android:text="＋ Onglet" />
        <TextView android:id="@+id/bookmark" style="@style/BottomButton" android:text="☆ Favori" />
        <TextView android:id="@+id/library" style="@style/BottomButton" android:text="☷ Bibliothèque" />
        <TextView android:id="@+id/reload" style="@style/BottomButton" android:text="↻ Actualiser" />
    </LinearLayout>
</LinearLayout>
