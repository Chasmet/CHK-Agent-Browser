<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D1423" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="DIAGNOSTIC MCP" android:textColor="#FFFFFF" android:textSize="24sp"
            android:textStyle="bold" android:paddingBottom="16dp"/>
        <TextView android:id="@+id/diagnostic_report" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#CAD8E9" android:textSize="15sp"
            android:lineSpacingExtra="5dp" android:paddingBottom="18dp"/>
        <Button android:id="@+id/diagnostic_reconnect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Reconnecter le MCP"
            android:textAllCaps="false"/>
        <Button android:id="@+id/diagnostic_copy" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Copier le diagnostic"
            android:textAllCaps="false"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Le diagnostic ne copie jamais le jeton d’installation, l’adresse MCP privée, les cookies ni les mots de passe."
            android:textColor="#8FA8C0" android:paddingTop="14dp"/>
    </LinearLayout>
</ScrollView>
