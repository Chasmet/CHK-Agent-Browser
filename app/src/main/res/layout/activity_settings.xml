<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1423">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp"
        android:paddingTop="18dp" android:paddingBottom="8dp">
        <Button android:id="@+id/settings_back" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="‹ Revenir à mon espace" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Réglages" android:textSize="25sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:paddingTop="14dp" android:paddingBottom="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingBottom="5dp">
            <Button android:id="@+id/settings_tab_general" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="52dp"
                android:contentDescription="Onglet Général"
                android:text="Général" android:textAllCaps="false" />
            <Button android:id="@+id/settings_tab_ai" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="52dp"
                android:contentDescription="Onglet IA locale"
                android:text="IA locale" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/settings_general_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="20dp"
            android:paddingRight="20dp" android:paddingBottom="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Navigation locale" android:textColor="#69E2C6" android:textSize="17sp" android:paddingBottom="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connexion Internet du téléphone ; aucun crédit d'API IA." android:textColor="#CAD8E9" android:paddingBottom="22dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mise à jour automatique" android:textColor="#69E2C6" android:textSize="19sp" />
    <TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Version : 1.0.0" android:textColor="#FFFFFF" android:paddingVertical="12dp" />
    <Switch android:id="@+id/auto_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Mise à jour automatique" android:textColor="#F1F5FF" />
    <Button android:id="@+id/check_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rechercher et télécharger la mise à jour" android:textAllCaps="false" />
    <Button android:id="@+id/install_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Installer la mise à jour sur ce téléphone" android:textAllCaps="false" android:visibility="gone" />
    <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#CAD8E9" android:paddingVertical="14dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mes connexions MCP · Render, Local 2 et Local 3" android:textColor="#69E2C6" android:textSize="19sp" android:paddingBottom="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trois connexions indépendantes : Render historique, Local 2 et Local 3 sur le serveur personnel. Chaque interrupteur fonctionne séparément." android:textColor="#CAD8E9" android:paddingBottom="10dp" />
    <TextView android:id="@+id/mcp_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MCP désactivé" android:textColor="#FFFFFF" android:paddingBottom="12dp" />
    <Button android:id="@+id/mcp_connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Activer / reconnecter MCP" android:textAllCaps="false" />
    <Button android:id="@+id/mcp_copy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copier l'adresse MCP pour ChatGPT" android:textAllCaps="false" />
    <Button android:id="@+id/mcp_diagnostic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Diagnostic connexion et commandes" android:textAllCaps="false" />
    <Button android:id="@+id/mcp_disable" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Désactiver MCP Render uniquement" android:textAllCaps="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Autonomie et autorisations" android:textColor="#69E2C6" android:textSize="19sp" android:paddingTop="20dp" android:paddingBottom="8dp" />
    <Switch android:id="@+id/autonomous_mode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Mode autonome : agir sans demander à chaque étape"
        android:textColor="#FFFFFF" android:paddingVertical="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="À activer volontairement. ChatGPT pourra naviguer, cliquer et remplir des formulaires dans la WebView, y compris sur des sites connectés. Tu peux couper ce mode ici ou arrêter le MCP dans la notification. Les champs de mot de passe restent bloqués."
        android:textColor="#CAD8E9" android:paddingBottom="12dp" />
    <Switch android:id="@+id/preview_mode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Autoriser les aperçus visuels de la page dans ChatGPT"
        android:textColor="#FFFFFF" android:paddingVertical="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Envoie une capture JPEG uniquement à la demande du plugin MCP. Les captures peuvent contenir des données privées de pages connectées. Ce n'est pas une WebView interactive intégrée à ChatGPT."
        android:textColor="#CAD8E9" android:paddingBottom="12dp" />
    <Button android:id="@+id/battery_settings" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Protéger la connexion écran éteint"
        android:textAllCaps="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Le service maintient la session écran éteint et se reconnecte au retour du réseau. Autorise la protection Batterie ci-dessus. Sur Honor/Huawei, autorise aussi le lancement et l’exécution en arrière-plan dans les réglages système. Ce mode utilise davantage de batterie. Téléphone complètement éteint : reprise après redémarrage, aucune connexion pendant l’arrêt."
        android:textColor="#CAD8E9" android:paddingVertical="10dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Le mode autonome mémorise ton accord pour tous les travaux du connecteur, après redémarrage et mise à jour. En mode manuel, chaque commande demande une validation. Ton adresse MCP reste privée." android:textColor="#CAD8E9" android:paddingVertical="12dp" />
    <Button android:id="@+id/clear_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Effacer l'historique local" android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <ScrollView android:id="@+id/settings_ai_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone"
        android:fillViewport="true">
        <LinearLayout android:id="@+id/ai_settings_content"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="20dp"
            android:paddingRight="20dp" android:paddingBottom="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Assistant IA local" android:textSize="21sp"
                android:textStyle="bold" android:textColor="#69E2C6"
                android:paddingTop="16dp" android:paddingBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Réglages dédiés au modèle open source embarqué. Ce module n'altère ni les connexions MCP ni les données enregistrées."
                android:textColor="#CAD8E9" android:paddingBottom="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
